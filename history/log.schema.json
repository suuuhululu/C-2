{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.c2.invalid/history/log-v1.json",
  "title": "Existing Backend history log format v1",
  "description": "Archive format, not live freshness, geometry or completion proof. Older C envelopes may omit diagnostics. Unknown events retain their result. Schema version is independent of design_version.",
  "type": "object",
  "required": ["timestamp", "job_id", "plan_id", "step_id", "request_id", "event", "result", "reason"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "job_id": {"type": "string", "format": "uuid"},
    "plan_id": {"$ref": "#/$defs/nullable_text"},
    "step_id": {"$ref": "#/$defs/nullable_text"},
    "request_id": {"$ref": "#/$defs/nullable_text"},
    "event": {"$ref": "#/$defs/text"},
    "reason": {"$ref": "#/$defs/nullable_text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nullable_text": {"type": ["string", "null"], "minLength": 1},
    "design": {"$ref": "../day4.schema.json#/$defs/design"},
    "candidate": {
      "type": "object", "required": ["design_version", "blocks"],
      "properties": {"design_version": {"type": "integer", "minimum": 1}, "blocks": {"type": "array"}}
    },
    "current": {
      "type": "object", "additionalProperties": false,
      "required": ["current_revision", "blocks"],
      "properties": {
        "current_revision": {"type": "integer", "minimum": 0},
        "blocks": {"$ref": "../day4.schema.json#/$defs/blocks"}
      }
    },
    "hri_payload": {
      "type": "object",
      "properties": {
        "job_id": {"$ref": "#/$defs/text"}, "request_id": {"$ref": "#/$defs/text"},
        "design_version": {"type": "integer", "minimum": 1},
        "current_revision": {"type": "integer", "minimum": 0},
        "design": {"$ref": "#/$defs/design"}, "current": {"$ref": "#/$defs/current"},
        "difference": {
          "type": "object", "required": ["missing", "unexpected", "unobservable"],
          "properties": {
            "missing": {"$ref": "../day4.schema.json#/$defs/blocks"},
            "unexpected": {"$ref": "../day4.schema.json#/$defs/blocks"},
            "unobservable": {"$ref": "../day4.schema.json#/$defs/blocks"}
          }
        }
      }
    },
    "c_result": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": {"enum": ["OK", "FAILED", "CANCELLED"]},
        "hri_result": {"enum": [null, "KEEP", "REVISE", "UNCLEAR"]},
        "design": {"oneOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
        "questions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "error": {"oneOf": [
          {"type": "null"},
          {"type": "object", "required": ["code", "message", "details"], "properties": {
            "code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"},
            "details": {"type": "array"}
          }}
        ]}
      },
      "if": {"properties": {"status": {"const": "OK"}}},
      "then": {"properties": {"error": {"type": "null"}}},
      "else": {"required": ["error"], "properties": {"error": {"type": "object"}}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "PLAN_ADOPTED"}}},
      "then": {"properties": {"result": {
        "type": "object", "required": ["design", "plan", "base_current", "confirmed_steps"],
        "properties": {
          "design": {"$ref": "#/$defs/design"},
          "plan": {"$ref": "../day4.schema.json#/$defs/plan"},
          "base_current": {"$ref": "#/$defs/current"}, "confirmed_steps": {"type": "array"}
        }
      }}}
    },
    {
      "if": {"properties": {"event": {"const": "CURRENT_ADOPTED"}}},
      "then": {"properties": {"request_id": {"$ref": "#/$defs/text"}, "result": {
        "type": "object", "required": ["current", "observed"], "properties": {
          "current": {"$ref": "#/$defs/current"},
          "observed": {"$ref": "../day4.schema.json#/$defs/observed"}
        }
      }}}
    },
    {
      "if": {"properties": {"event": {"const": "PLAN_RESULT"}}},
      "then": {"properties": {"result": {"$ref": "../day4.schema.json#/$defs/plan_result"}}}
    },
    {
      "if": {"properties": {"event": {"enum": ["QUESTION_OPENED", "QUESTION_RECEIVED"]}}},
      "then": {"properties": {"request_id": {"$ref": "#/$defs/text"}, "result": {"$ref": "#/$defs/text"}}}
    },
    {
      "if": {"properties": {"event": {"const": "INTENT_RECEIVED"}}},
      "then": {"properties": {"request_id": {"$ref": "#/$defs/text"}, "result": {
        "type": "object", "required": ["decision"],
        "properties": {"decision": {"enum": ["KEEP", "REVISE", "UNCLEAR"]}},
        "allOf": [
          {"if": {"properties": {"decision": {"const": "REVISE"}}},
           "then": {"required": ["design"], "properties": {"design": {"$ref": "#/$defs/design"}}}},
          {"if": {"properties": {"decision": {"const": "UNCLEAR"}}},
           "then": {"required": ["question"], "properties": {"question": {"$ref": "#/$defs/text"}}}}
        ]
      }}}
    },
    {
      "if": {"properties": {"event": {"const": "REQUEST_SENT"}}},
      "then": {"properties": {"result": {
        "type": "object", "required": ["port", "payload"],
        "properties": {"port": {"$ref": "#/$defs/text"}, "payload": {"type": "object"}},
        "if": {"properties": {"port": {"const": "hri"}}},
        "then": {"properties": {"payload": {"$ref": "#/$defs/hri_payload"}}}
      }}}
    },
    {
      "if": {"properties": {"event": {"const": "REQUEST_SENT"}, "result": {"properties": {"port": {"const": "hri"}}}}},
      "then": {"properties": {"request_id": {"$ref": "#/$defs/text"}}}
    },
    {
      "if": {"properties": {"event": {"const": "DELIVERY_RESULT"}}},
      "then": {"properties": {"result": {
        "type": "object", "required": ["success", "reason"],
        "properties": {"success": {"type": "boolean"}, "reason": {"$ref": "#/$defs/nullable_text"}},
        "if": {"properties": {"success": {"const": false}}},
        "then": {"properties": {"reason": {"$ref": "#/$defs/text"}}}
      }}}
    },
    {
      "if": {"properties": {"event": {"enum": ["INITIAL_DESIGN_RECEIVED", "C_INTERVENTION_RESULT"]}}},
      "then": {"properties": {"result": {"$ref": "#/$defs/c_result"}}}
    },
    {
      "if": {"properties": {"event": {"const": "INITIAL_DESIGN_RECEIVED"}, "result": {"properties": {"status": {"const": "OK"}}}}},
      "then": {"properties": {"result": {
        "required": ["design"], "properties": {"design": {"$ref": "#/$defs/candidate"}, "hri_result": {"type": "null"}}
      }}}
    },
    {
      "if": {"properties": {"event": {"const": "C_INTERVENTION_RESULT"}}},
      "then": {"properties": {"request_id": {"$ref": "#/$defs/text"}, "result": {
        "if": {"properties": {"status": {"const": "OK"}}},
        "then": {
          "required": ["hri_result"], "properties": {"hri_result": {"enum": ["KEEP", "REVISE", "UNCLEAR"]}},
          "if": {"properties": {"hri_result": {"enum": ["KEEP", "REVISE"]}}},
          "then": {"required": ["design"], "properties": {"design": {"$ref": "#/$defs/candidate"}}},
          "else": {"required": ["questions"], "properties": {"questions": {"type": "array", "minItems": 1}}}
        }
      }}}
    }
  ]
}
