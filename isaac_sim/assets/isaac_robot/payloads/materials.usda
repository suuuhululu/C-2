        )
        prepend token outputs:surface.connect = </Materials/rg2_base_link_visual_0_material/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/rg2_base_link_visual_0_material.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/rg2_base_link_visual_0_material.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/rg2_base_link_visual_0_material.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/rg2_base_link_visual_0_material.inputs:roughness>
            token outputs:displacement
