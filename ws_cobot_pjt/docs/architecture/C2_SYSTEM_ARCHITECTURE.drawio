        <mxCell id="p2-v2" value="A1·A2는 서로 다른 장시간 작업(Action)이다. 경로 생성 완료 후 운영자 확인을 거쳐 별도의 실행 요청을 보낸다." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="42" y="82" width="1690" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2-v3" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="137" width="1720" height="3" as="geometry" />
        </mxCell>
        <mxCell id="p2-v4" value="C-2  |  2026-09-18  |  기준 main c414821 + Clay 로컬 이관  |  설계 v1  |  02 / 08" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2-v5" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;A1  /c2/generate_path&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;c2_interfaces/action/GeneratePath  [타입 파일·서버 구현 전]&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F3EFFB;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-v6" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;A2  /c2/execute_process&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;c2_interfaces/action/ExecuteProcess  [타입 파일·서버 구현 전]&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#18764C;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="920" y="170" width="840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-v7" value="monitor_gateway_node → path_planner_node" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=20;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#7551B8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2-v8" value="monitor_gateway_node → process_controller_node" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=20;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#18764C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="290" width="800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2-v9" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Goal  →  요청 필드&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;schema_version, request_id, source_mode&lt;br&gt;asset_id, asset_sha256&lt;br&gt;width_mm, height_mm, offset_u_mm, offset_v_mm, rotation_deg&lt;br&gt;conversion_preset&lt;br&gt;tool_id, profile_snapshot_id, profile_sha256&lt;br&gt;크기는 양수 float64 / 배치 mm / 화면 회전 deg&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="840" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p2-v10" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Goal  →  요청 필드&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;schema_version, request_id, run_id, source_mode&lt;br&gt;path_id, path_version, path_sha256&lt;br&gt;operator_confirmed_fixture (bool)&lt;br&gt;operator_id, confirmed_at&lt;br&gt;미리보기와 같은 경로 식별자를 전달한다.&lt;br&gt;운영자 확인은 서버가 기록하며 센서 확인과 구분한다.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#18764C;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="345" width="840" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p2-v11" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Feedback  ←  진행&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;request_id, stage, progress (0~1, 처리 진행 추정치)&lt;br&gt;CONVERTING → EXTRACTING_2D → OPTIMIZING_2D&lt;br&gt;→ MAPPING_3D → BUILDING_PATH → VALIDATING&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="840" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-v12" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Feedback  ←  진행&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;run_id, phase, engraving_progress&lt;br&gt;completed_segment_id, elapsed_s&lt;br&gt;조각 진행률 = 확인된 완료 CUT 길이 / 전체 CUT 길이&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#18764C;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="605" width="840" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-v13" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Result  ←  생성 결과&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;success, error_code, message&lt;br&gt;path_id, path_version, path_sha256&lt;br&gt;svg_asset_id, preview_asset_id&lt;br&gt;segment_count, cut_length_m&lt;br&gt;validation_passed, validation_report_id&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="775" width="840" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-v14" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;Result  ←  실행 결과&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;run_id, outcome, error_code, message&lt;br&gt;last_completed_segment_id, log_id&lt;br&gt;outcome: SUCCEEDED / FAILED / STOPPED / UNKNOWN&lt;br&gt;SUCCEEDED = 이탈·필요한 청소·반납까지 완료 확인&lt;br&gt;제품 검사 PASS는 별도 기록이다.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#18764C;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="775" width="840" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2-v15" value="공통: schema_version=1(uint16) · request_id/run_id=UUID 문자열 · path_version=uint32 · source_mode=SIMULATION|REAL&#10;입력·설정·경로는 관리 ID와 SHA-256으로 연결한다. 나머지 자료형의 최종 확정은 공통 .action 정의 PR에서 검토한다." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1005" width="1720" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c2-page-03" name="03 노드 간 계약 · 정지, 상태, 이벤트">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-v1" value="03  노드 간 계약 · 정지, 상태, 이벤트" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=32;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#182B49;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1600" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p3-v2" value="S1은 정지 접수 응답이다. 실제 정지 완료는 T1과 A2 결과로 확인한다. T1·T2 모두 공정 제어 → 모니터 방향이다." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="42" y="82" width="1690" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p3-v3" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="137" width="1720" height="3" as="geometry" />
        </mxCell>
        <mxCell id="p3-v4" value="C-2  |  2026-09-18  |  기준 main c414821 + Clay 로컬 이관  |  설계 v1  |  03 / 08" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3-v5" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;S1  /c2/stop_process&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;c2_interfaces/srv/StopProcess&lt;br&gt;모니터 → 공정 제어 → 모니터&lt;br&gt;&lt;br&gt;Request&lt;br&gt;schema_version, request_id, run_id, reason&lt;br&gt;&lt;br&gt;Response&lt;br&gt;accepted, run_id, stop_state&lt;br&gt;error_code, message&lt;br&gt;&lt;br&gt;Action 취소도 같은 정지 절차를 사용한다.&lt;br&gt;같은 run_id 확인 / 정지 latch 우선 처리&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#C54245;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="540" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p3-v6" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;T1  /c2/process_state&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;c2_interfaces/msg/ProcessState&lt;br&gt;공정 제어 Publisher → 모니터 Subscriber&lt;br&gt;&lt;br&gt;식별: schema_version, source_mode,&lt;br&gt;source_epoch, seq(uint64), 발행 시각&lt;br&gt;실행: run_id, path_id/version, status, phase,&lt;br&gt;engraving_progress, elapsed_s&lt;br&gt;정지·오류: stop_state, error_code, message&lt;br&gt;도구: requested_tool_id, mounted_tool_id,&lt;br&gt;tool_confirmation_source, grip_state&lt;br&gt;로봇: 관절 rad / TCP Pose·frame / 운전·연결&lt;br&gt;신호별 quality + 측정 시각&lt;br&gt;&lt;br&gt;status&lt;br&gt;IDLE / RUNNING / STOPPING / STOPPED&lt;br&gt;SUCCEEDED / FAILED / UNKNOWN&lt;br&gt;&lt;br&gt;quality&lt;br&gt;VALID / STALE / UNKNOWN / UNSUPPORTED&lt;br&gt;&lt;br&gt;grip_state&lt;br&gt;UNKNOWN / OPENING / OPEN / CLOSING&lt;br&gt;GRIPPED / EMPTY / ERROR&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#087F8C;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="610" y="170" width="570" height="660" as="geometry" />
        </mxCell>
        <mxCell id="p3-v7" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;T2  /c2/process_events&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;c2_interfaces/msg/ProcessEvent&lt;br&gt;공정 제어 Publisher → 모니터 Subscriber&lt;br&gt;&lt;br&gt;schema_version, source_mode, event_id&lt;br&gt;source_epoch, event_seq, run_id, request_id&lt;br&gt;occurred_at, event_type, phase, severity&lt;br&gt;code, message, segment_id, 설정·경로 식별자&lt;br&gt;&lt;br&gt;event_type&lt;br&gt;COMMAND / PHASE_CHANGED&lt;br&gt;ALARM_RAISED / ALARM_CLEARED&lt;br&gt;RUN_FINISHED&lt;br&gt;&lt;br&gt;발생 시각과 서버 수신 시각을 구분한다.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F3EFFB;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1210" y="170" width="550" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p3-v8" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:700;margin-bottom:8px&quot;&gt;정지 상태&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;NONE → REQUESTED → ACCEPTED&lt;br&gt;→ STOPPING → CONFIRMED&lt;br&gt;별도 FAILED / UNKNOWN&lt;br&gt;접수 수락 ≠ 실제 정지&lt;br&gt;확인 불가 시 새 실행 차단&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C54245;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="635" width="540" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p3-v9" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;이벤트 복구와 화면 표시&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;중요 사건: 실행 저널에 기록 → 서버 DB 반영&lt;br&gt;event_id로 중복 제거 / 누락 저널 재조회&lt;br&gt;source_epoch·seq로 오래된 상태 제외&lt;br&gt;무효 센서값은 JSON null + quality&lt;br&gt;heartbeat와 센서 측정 시각은 별개&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="635" width="550" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p3-v10" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:16px&quot;&gt;구분&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;fontColor=#FFFFFF;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="865" width="330" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p3-v11" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:16px&quot;&gt;v1 초기 제안&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;fontColor=#FFFFFF;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="865" width="610" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p3-v12" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:16px&quot;&gt;초과·오류 시 동작&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;fontColor=#FFFFFF;fontStyle=1;spacing=12;" vertex="1" parent="1">
