        <mxCell id="p5-v1" value="05  파일·좌표·화면 API의 연결" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=32;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#182B49;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1600" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p5-v2" value="원본과 경로 본문은 로컬 파일로 저장한다. ROS에는 관리 ID·버전·해시를 전달하며 임의 절대 경로를 입력받지 않는다." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="42" y="82" width="1690" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p5-v3" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#182B49;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="137" width="1720" height="3" as="geometry" />
        </mxCell>
        <mxCell id="p5-v4" value="C-2  |  2026-09-18  |  기준 main c414821 + Clay 로컬 이관  |  설계 v1  |  05 / 08" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=12;shadow=0;rounded=0;spacing=0;verticalAlign=middle;fontColor=#52657F;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p5-v5" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;① 서버가 원본·설정 보관&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;asset_id / asset_sha256&lt;br&gt;profile_snapshot_id / profile_sha256&lt;br&gt;workcell.yaml: 고정 변환·표면·영역&lt;br&gt;tools.yaml: 도구·TCP·하중·가공·청소&lt;br&gt;스냅샷은 불변 파일로 보관&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2667C9;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p5-v6" value="&lt;div style=&quot;font-family:Arial,Apple SD Gothic Neo,Malgun Gothic,sans-serif;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:700;margin-bottom:8px&quot;&gt;② 경로 생성과 파일 공개&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;path.json: schema / path_id / version&lt;br&gt;asset·profile 참조 + mode + frame_id&lt;br&gt;segments: segment_id / stroke_id / kind&lt;br&gt;waypoints / motion_profile_id / 완료 검증&lt;br&gt;SVG / preview / validation_report&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F3EFFB;strokeColor=#7551B8;strokeWidth=1.5;fontColor=#182B49;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=12;shadow=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
