           <item row="4" column="1"><widget class="QSpinBox" name="spin_fill"><property name="minimum"><number>10</number></property><property name="maximum"><number>100</number></property><property name="value"><number>85</number></property><property name="toolTip"><string>작업 구간에 들어갈 수 있는 최대 크기 대비 비율</string></property></widget></item>
