           <item row="3" column="1"><widget class="QDoubleSpinBox" name="spin_zoff"><property name="minimum"><double>-300.0</double></property><property name="maximum"><double>300.0</double></property><property name="value"><double>0.0</double></property><property name="toolTip"><string>작업 구간 중앙 기준 위(+)/아래(−)</string></property></widget></item>
