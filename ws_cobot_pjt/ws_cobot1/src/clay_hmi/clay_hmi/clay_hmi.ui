           <item row="2" column="1"><widget class="QDoubleSpinBox" name="spin_angle"><property name="minimum"><double>-180.0</double></property><property name="maximum"><double>180.0</double></property><property name="value"><double>0.0</double></property><property name="toolTip"><string>0 = 로봇 앞쪽(+X) 중앙. 원통에서만 의미</string></property></widget></item>
