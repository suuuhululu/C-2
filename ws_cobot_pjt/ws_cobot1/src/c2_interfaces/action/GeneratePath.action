# /c2/generate_path: 모니터 → 좌표 노드. 이미지·설정의 관리 ID만 전달한다.
# 스키마·UUID·SHA-256·유한 수치·양수 크기·지원 preset 검증은 수신 노드 책임.
uint16 SCHEMA_VERSION=1
uint16 schema_version 1
string request_id
# SIMULATION 또는 REAL. 노드의 실제 실행 설정과 일치해야 한다.
string source_mode
string asset_id
string asset_sha256
float64 width_mm
float64 height_mm
# 도안 중심 U/V, 중심 기준 반시계 회전. 표면 기준은 설정 스냅샷 참조.
float64 offset_u_mm
float64 offset_v_mm
float64 rotation_deg
string conversion_preset
string tool_id
string profile_snapshot_id
string profile_sha256
---
# 실패·취소는 success=false, validation_passed=false, 경로 ID/해시 비움, 버전 0.
# 파일 저장·검증이 끝난 실행 경로만 공개한다. 실기 가공 합격과 별개다.
bool success false
string error_code "UNKNOWN"
string message
string path_id
uint32 path_version
string path_sha256
string svg_asset_id
string preview_asset_id
uint32 segment_count
float64 cut_length_m
bool validation_passed false
string validation_report_id
---
string request_id
# CONVERTING, EXTRACTING_2D, OPTIMIZING_2D, MAPPING_3D, BUILDING_PATH, VALIDATING
string stage
# 유한 수치 0..1. 생성 완료만으로 실행 요청을 보내지 않는다.
float64 progress
