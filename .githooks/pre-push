#!/bin/sh
# Git supplies: local-ref local-object remote-ref remote-object.
# Check the destination, so HEAD:main and branch deletion are covered too.
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        printf '%s\n' \
            '차단: main 브랜치로 직접 push하거나 삭제할 수 없습니다.' \
            '작업 브랜치를 push한 뒤 GitHub에서 main 대상 PR을 제출하세요.' >&2
        exit 1
    fi
done
