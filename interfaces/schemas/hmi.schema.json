{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c-2.invalid/schemas/hmi.schema.json",
  "title": "Day4 Backend-HMI contracts with optional final MVP display fields",
  "description": "Explicit FAKE or REAL display/input. REAL binds a single transfer trial or an explicit manual field-confirmation trial bounded by four six-slot rows (up to 24 Steps). Consumer checks cross-field consistency, not physical completion proof.",
  "oneOf": [{"$ref":"#/$defs/snapshot"},{"$ref":"#/$defs/command"},{"$ref":"#/$defs/user_request"},{"$ref":"#/$defs/user_reply"}],
  "$defs": {
    "design_preview": {
      "type":"object", "additionalProperties":false, "required":["request_id","design"],
      "properties":{"request_id":{"$ref":"day4.schema.json#/$defs/id"},"design":{"$ref":"day4.schema.json#/$defs/design"}}
    },
    "dialogue": {
      "type":"object", "additionalProperties":false, "required":["request_id","phase","user_text","assistant_text","reason"],
      "properties":{"request_id":{"$ref":"day4.schema.json#/$defs/id"},"phase":{"enum":["LISTENING","GENERATING","SPEAKING","REVIEW","WAIT_APPROVAL","FAILED"]},"user_text":{"$ref":"#/$defs/nullable_id"},"assistant_text":{"$ref":"#/$defs/nullable_id"},"reason":{"$ref":"#/$defs/nullable_id"}},
      "allOf":[{"if":{"properties":{"phase":{"const":"FAILED"}}},"then":{"properties":{"reason":{"$ref":"day4.schema.json#/$defs/id"}}}}]
    },
    "execution": {
      "type":"object", "additionalProperties":false, "required":["plan_id","step_id","motion_plan_id","method","phase"],
      "properties":{"plan_id":{"$ref":"day4.schema.json#/$defs/id"},"step_id":{"$ref":"day4.schema.json#/$defs/id"},"motion_plan_id":{"$ref":"#/$defs/nullable_id"},"method":{"enum":["ROBOT_GRIP","HUMAN_ASSEMBLY"]},"phase":{"enum":["APPROACH_PICK","PICK_AND_CONFIRM","TRANSPORT_HOLDING","PRE_CONTACT","CONTACT","RELEASE","RETREAT","WAIT_INSPECTION","HOLD"]}},
      "allOf":[{"if":{"properties":{"method":{"const":"HUMAN_ASSEMBLY"}}},"then":{"properties":{"phase":{"not":{"const":"CONTACT"}}}}}]
    },
    "assistance": {
      "type":"object", "additionalProperties":false, "required":["request_id","plan_id","step_id","kind","target","instruction","phase"],
      "properties":{"request_id":{"$ref":"day4.schema.json#/$defs/id"},"plan_id":{"$ref":"day4.schema.json#/$defs/id"},"step_id":{"$ref":"day4.schema.json#/$defs/id"},"kind":{"enum":["SUPPORT","HANDOVER","HUMAN_ASSEMBLY"]},"target":{"$ref":"day4.schema.json#/$defs/block"},"instruction":{"$ref":"day4.schema.json#/$defs/id"},"phase":{"enum":["REQUESTED","READY","MAINTAIN","RELEASED","CANCELED"]}}
    },
    "completion": {
      "type":"object", "additionalProperties":false, "required":["blocks_used","assembly","storage","web","reason"],
      "properties":{"blocks_used":{"type":"boolean"},"assembly":{"enum":["PENDING","MATCH","MISMATCH","UNOBSERVABLE"]},"storage":{"enum":["NOT_STARTED","PENDING","SUCCEEDED","FAILED"]},"web":{"enum":["NOT_STARTED","PENDING","SUCCEEDED","FAILED"]},"reason":{"$ref":"#/$defs/nullable_id"}},
      "allOf":[
        {"if":{"properties":{"assembly":{"not":{"const":"PENDING"}}}},"then":{"properties":{"blocks_used":{"const":true}}}},
        {"if":{"properties":{"storage":{"not":{"const":"NOT_STARTED"}}}},"then":{"properties":{"assembly":{"const":"MATCH"}}}},
        {"if":{"properties":{"web":{"not":{"const":"NOT_STARTED"}}}},"then":{"properties":{"storage":{"const":"SUCCEEDED"}}}},
        {"if":{"anyOf":[{"properties":{"assembly":{"enum":["MISMATCH","UNOBSERVABLE"]}}},{"properties":{"storage":{"const":"FAILED"}}},{"properties":{"web":{"const":"FAILED"}}}]},"then":{"properties":{"reason":{"$ref":"day4.schema.json#/$defs/id"}}}}
      ]
    },
    "inspection": {"type":"object","additionalProperties":false,"required":["check_id","check_kind","plan_id","step_id","status","comparison","expected","difference","reason"],"properties":{"check_id":{"$ref":"day4.schema.json#/$defs/id"},"check_kind":{"enum":["INITIAL","STEP","FINAL"]},"plan_id":{"$ref":"#/$defs/nullable_id"},"step_id":{"$ref":"#/$defs/nullable_id"},"status":{"enum":["OK","UNOBSERVABLE","ERROR","CANCELED"]},"comparison":{"enum":[null,"MATCH","MISMATCH","UNOBSERVABLE"]},"expected":{"anyOf":[{"type":"object","additionalProperties":false,"required":["plan_id","step_id","blocks"],"properties":{"plan_id":{"$ref":"day4.schema.json#/$defs/id"},"step_id":{"$ref":"#/$defs/nullable_id"},"blocks":{"type":"array","items":{"$ref":"day4.schema.json#/$defs/block"}}}},{"type":"null"}]},"difference":{"anyOf":[{"type":"object","additionalProperties":false,"required":["missing","unexpected","unobservable"],"properties":{"missing":{"type":"array","items":{"$ref":"day4.schema.json#/$defs/block"}},"unexpected":{"type":"array","items":{"$ref":"day4.schema.json#/$defs/block"}},"unobservable":{"type":"array","items":{"$ref":"day4.schema.json#/$defs/block"}}}},{"type":"null"}]},"reason":{"$ref":"#/$defs/nullable_id"}}},
    "user_requests": {"type":"object","additionalProperties":false,"required":["change_design","home","assistance_ready"],"properties":{"change_design":{"$ref":"#/$defs/request_button"},"home":{"$ref":"#/$defs/request_button"},"assistance_ready":{"$ref":"#/$defs/request_button"}}},
    "user_request": {"type":"object","additionalProperties":false,"required":["command","job_id","request_id"],"properties":{"command":{"enum":["REQUEST_DESIGN_CHANGE","REQUEST_HOME","ASSISTANCE_READY"]},"job_id":{"$ref":"day4.schema.json#/$defs/id"},"request_id":{"$ref":"day4.schema.json#/$defs/id"}}},
    "user_reply": {"type":"object","additionalProperties":false,"required":["command","job_id","request_id","accepted","reason"],"properties":{"command":{"enum":["REQUEST_DESIGN_CHANGE","REQUEST_HOME","ASSISTANCE_READY"]},"job_id":{"$ref":"day4.schema.json#/$defs/id"},"request_id":{"$ref":"day4.schema.json#/$defs/id"},"accepted":{"type":"boolean"},"reason":{"$ref":"#/$defs/nullable_id"}},"allOf":[{"if":{"properties":{"accepted":{"const":false}}},"then":{"properties":{"reason":{"$ref":"day4.schema.json#/$defs/id"}}}}]},
    "nullable_id": {"anyOf":[{"$ref":"day4.schema.json#/$defs/id"},{"type":"null"}]},
    "nullable_sequence": {"anyOf":[{"$ref":"day4.schema.json#/$defs/sequence"},{"type":"null"}]},
    "button": {
      "type":"object", "additionalProperties":false, "required":["visible","enabled"],
      "properties":{"visible":{"type":"boolean"},"enabled":{"type":"boolean"}},
      "allOf":[{"if":{"properties":{"visible":{"const":false}}},"then":{"properties":{"enabled":{"const":false}}}}]
    },
    "request_button": {
      "type":"object", "additionalProperties":false, "required":["visible","enabled","request_id"],
      "properties":{"visible":{"type":"boolean"},"enabled":{"type":"boolean"},"request_id":{"$ref":"#/$defs/nullable_id"}}
    },
    "refill_button": {
      "type":"object", "additionalProperties":false, "required":["brick_type","color","visible","enabled"],
      "properties":{"brick_type":{"enum":["2x2x1","2x3x1"]},"color":{"enum":["yellow","blue"]},"visible":{"type":"boolean"},"enabled":{"type":"boolean"}}
    },
    "supply": {
      "type":"object", "additionalProperties":false, "required":["brick_type","color","next_slot","needs_refill"],
      "properties":{"brick_type":{"enum":["2x2x1","2x3x1"]},"color":{"enum":["yellow","blue"]},"next_slot":{"type":["integer","null"],"minimum":1,"maximum":6},"needs_refill":{"type":["boolean","null"]}}
    },
    "transfer_target": {
      "type":"object", "additionalProperties":false, "required":["brick_type","color","slot"],
      "properties":{"brick_type":{"enum":["2x2x1","2x3x1"]},"color":{"enum":["yellow","blue"]},"slot":{"type":"integer","minimum":1,"maximum":6}}
    },
    "step": {
      "type":"object", "additionalProperties":false, "required":["plan_id","step_id","target","observed","comparison"],
      "properties": {
        "plan_id":{"$ref":"#/$defs/nullable_id"},"step_id":{"$ref":"#/$defs/nullable_id"},
        "target":{"anyOf":[{"$ref":"day4.schema.json#/$defs/block"},{"type":"null"}]},
        "observed":{"anyOf":[{"$ref":"day4.schema.json#/$defs/observed"},{"type":"null"}]},
        "comparison":{"enum":["WAITING","MATCH","MISMATCH","UNOBSERVABLE"]}
      }
    },
    "progress": {
      "type":"object", "additionalProperties":false, "required":["completed","total"],
      "properties":{"completed":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":0}}
    },
    "robot": {
      "type":"object", "additionalProperties":false, "required":["mode","status"],
      "properties":{"mode":{"enum":["FAKE","REAL"]},"status":{"enum":[null,"IDLE","BUSY","STOP_PENDING","STOPPED","ERROR"]}}
    },
    "observation": {
      "type":"object", "additionalProperties":false, "required":["status","check_id","observation_seq","reason"],
      "properties":{"status":{"enum":[null,"OK","UNOBSERVABLE"]},"check_id":{"$ref":"#/$defs/nullable_id"},"observation_seq":{"$ref":"#/$defs/nullable_sequence"},"reason":{"$ref":"#/$defs/nullable_id"}}
    },
    "monitor": {
      "type":"object", "additionalProperties":false, "required":["robot","observation","place_status","supply"],
      "properties":{"robot":{"$ref":"#/$defs/robot"},"observation":{"$ref":"#/$defs/observation"},"place_status":{"enum":[null,"EMPTY","OCCUPIED","UNOBSERVABLE"]},"supply":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/supply"}}}
    },
    "notice": {
      "type":"object", "additionalProperties":false, "required":["question","reason","required_action","request_id"],
      "properties":{"question":{"$ref":"#/$defs/nullable_id"},"reason":{"$ref":"#/$defs/nullable_id"},"required_action":{"$ref":"#/$defs/nullable_id"},"request_id":{"$ref":"#/$defs/nullable_id"}}
    },
    "actions": {
      "type":"object", "additionalProperties":false, "required":["job_id","start","stop","resume","intent_choice","correction_continue","supply_refill"],
      "properties": {
        "job_id":{"$ref":"#/$defs/nullable_id"},"start":{"$ref":"#/$defs/button"},"stop":{"$ref":"#/$defs/button"},"resume":{"$ref":"#/$defs/button"},
        "prepare_observe":{"$ref":"#/$defs/button"},
        "intent_choice":{"$ref":"#/$defs/request_button"},"correction_continue":{"$ref":"#/$defs/request_button"},
        "supply_refill":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/refill_button"}}
      }
    },
    "snapshot": {
      "type":"object", "additionalProperties":false, "required":["workflow_status","step","progress","monitor","notice","actions","design","current"],
      "allOf":[{
        "if":{"properties":{"monitor":{"properties":{"robot":{"properties":{"mode":{"const":"REAL"}}}}}}},
        "then":{"if":{"required":["manual_trial"],"properties":{"manual_trial":{"const":true}}},
          "then":{"properties":{
            "workflow_status":{"enum":["IDLE","PREPARING","DELIVERING","WAIT_ASSEMBLY","WAIT_INTENT","REPLANNING","WAIT_CORRECTION","HOLD","STOPPED","COMPLETE"]},
            "progress":{"properties":{"total":{"type":"integer","minimum":0,"maximum":24}}}
          },"not":{"required":["transfer_target"]}},
          "else":{"properties":{
          "workflow_status":{"enum":["IDLE","DELIVERING","HOLD","STOPPED"]},"design":{"type":"null"},
          "step":{"properties":{"target":{"type":"null"}}},
          "progress":{"properties":{"completed":{"const":0},"total":{"const":0}}}
        }}},
        "else":{"not":{"anyOf":[{"required":["transfer_target"]},{"required":["manual_trial"]}]}}
      },{
        "if":{"properties":{"actions":{"required":["prepare_observe"]}}},
        "then":{"properties":{
          "workflow_status":{"const":"IDLE"},
          "monitor":{"properties":{"robot":{"properties":{"mode":{"const":"REAL"}}}}},
          "actions":{"properties":{"job_id":{"type":"null"}}}
        }}
      },{
        "if":{"required":["reported_placement"]},
        "then":{"required":["manual_trial"],"properties":{
          "manual_trial":{"const":true},"monitor":{"properties":{"robot":{"properties":{"mode":{"const":"REAL"}}}}},
          "step":{"properties":{"comparison":{"const":"MISMATCH"},"observed":{"type":"object"}}}
        }}
      }],
      "dependentSchemas": {
        "completion":{"if":{"properties":{"workflow_status":{"const":"COMPLETE"}}},"then":{"properties":{"completion":{"properties":{"assembly":{"const":"MATCH"}}}}}}
      },
      "properties": {
        "user_requests":{"$ref":"#/$defs/user_requests"},"inspection":{"$ref":"#/$defs/inspection"},"design_preview":{"$ref":"#/$defs/design_preview"},"dialogue":{"$ref":"#/$defs/dialogue"},
        "execution":{"$ref":"#/$defs/execution"},"assistance":{"$ref":"#/$defs/assistance"},"completion":{"$ref":"#/$defs/completion"},
        "workflow_status":{"enum":["IDLE","PREPARING","DELIVERING","WAIT_ASSEMBLY","WAIT_INTENT","REPLANNING","WAIT_CORRECTION","HOLD","STOPPED","COMPLETE"]},
        "step":{"$ref":"#/$defs/step"},"progress":{"$ref":"#/$defs/progress"},"monitor":{"$ref":"#/$defs/monitor"},"notice":{"$ref":"#/$defs/notice"},"actions":{"$ref":"#/$defs/actions"},
        "design":{"anyOf":[{"$ref":"day4.schema.json#/$defs/design"},{"type":"null"}]},
        "current":{"$ref":"day4.schema.json#/$defs/current"},
        "transfer_target":{"$ref":"#/$defs/transfer_target"},
        "manual_trial":{"type":"boolean","const":true},
        "reported_placement":{"$ref":"day4.schema.json#/$defs/block"}
      }
    },
    "command": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["command"],"properties":{"command":{"const":"START"}}},
        {"type":"object","additionalProperties":false,"required":["command"],"properties":{"command":{"const":"PREPARE_OBSERVE"}}},
        {"type":"object","additionalProperties":false,"required":["command"],"properties":{"command":{"enum":["STOP_PREPARATION","RESUME_PREPARATION"]}}},
        {"type":"object","additionalProperties":false,"required":["command","job_id"],"properties":{"command":{"enum":["STOP","RESUME"]},"job_id":{"$ref":"day4.schema.json#/$defs/id"}}},
        {"type":"object","additionalProperties":false,"required":["command","job_id","request_id","choice"],"properties":{"command":{"const":"CHOOSE_INTENT"},"job_id":{"$ref":"day4.schema.json#/$defs/id"},"request_id":{"$ref":"day4.schema.json#/$defs/id"},"choice":{"enum":["KEEP","REVISE"]}}},
        {"type":"object","additionalProperties":false,"required":["command","job_id","request_id"],"properties":{"command":{"const":"CONTINUE_AFTER_CORRECTION"},"job_id":{"$ref":"day4.schema.json#/$defs/id"},"request_id":{"$ref":"day4.schema.json#/$defs/id"}}},
        {"type":"object","additionalProperties":false,"required":["command","job_id","brick_type","color"],"properties":{"command":{"const":"SUPPLY_REFILLED"},"job_id":{"$ref":"day4.schema.json#/$defs/id"},"brick_type":{"enum":["2x2x1","2x3x1"]},"color":{"enum":["yellow","blue"]}}}
      ]
    }
  }
}
